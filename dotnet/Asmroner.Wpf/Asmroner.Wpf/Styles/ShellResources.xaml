<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="ShellBackgroundBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0"
                      Color="#FFF5FAFF"/>
        <GradientStop Offset="1"
                      Color="#FFEFF6FF"/>
    </LinearGradientBrush>

    <Style x:Key="ShellCardBorderBaseStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="#FFFFFFFF"/>
        <Setter Property="BorderBrush"
                Value="#FFE3ECF7"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="CornerRadius"
                Value="14"/>
        <Setter Property="Padding"
                Value="14"/>
    </Style>

    <Style x:Key="ShellSectionTitleStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="15"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="#FF1E2A3A"/>
        <Setter Property="Margin"
                Value="0,0,0,8"/>
    </Style>

    <Style x:Key="ShellMutedLabelStyle"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="#FF5A6A80"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="Margin"
                Value="0,0,6,4"/>
    </Style>

    <Style x:Key="ShellFieldLabelStyle"
           TargetType="TextBlock">
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="#FF40546C"/>
        <Setter Property="Margin"
                Value="0,2,0,4"/>
    </Style>

    <Style x:Key="ShellFieldTextBoxBaseStyle"
           TargetType="TextBox">
        <Setter Property="Height"
                Value="34"/>
        <Setter Property="Padding"
                Value="10,4"/>
        <Setter Property="BorderBrush"
                Value="#FFD6E3F2"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Background"
                Value="#FFFFFFFF"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
    </Style>

    <Style x:Key="ShellFieldPasswordBoxBaseStyle"
           TargetType="PasswordBox">
        <Setter Property="Height"
                Value="34"/>
        <Setter Property="Padding"
                Value="10,4"/>
        <Setter Property="BorderBrush"
                Value="#FFD6E3F2"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Background"
                Value="#FFFFFFFF"/>
    </Style>

    <Style x:Key="ShellFieldComboBoxBaseStyle"
           TargetType="ComboBox">
        <Setter Property="Height"
                Value="34"/>
        <Setter Property="Padding"
                Value="8,3"/>
        <Setter Property="BorderBrush"
                Value="#FFD6E3F2"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Background"
                Value="#FFFFFFFF"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Center"/>
    </Style>

    <Style x:Key="ShellComboBoxItemStyle"
           TargetType="ComboBoxItem">
        <Setter Property="HorizontalContentAlignment"
                Value="Center"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
        <Setter Property="Padding"
                Value="8,4"/>
    </Style>

    <Style x:Key="ShellActionButtonBaseStyle"
           TargetType="Button">
        <Setter Property="Padding"
                Value="12,5"/>
        <Setter Property="Height"
                Value="34"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="White"/>
        <Setter Property="Background"
                Value="#FF3D8DFF"/>
        <Setter Property="BorderBrush"
                Value="#FF3D8DFF"/>
    </Style>

    <Style x:Key="ShellLightActionButtonBaseStyle"
           TargetType="Button"
           BasedOn="{StaticResource ShellActionButtonBaseStyle}">
        <Setter Property="Foreground"
                Value="#FF24507A"/>
        <Setter Property="Background"
                Value="#FFE8F2FF"/>
        <Setter Property="BorderBrush"
                Value="#FFD2E5FF"/>
    </Style>
</ResourceDictionary>