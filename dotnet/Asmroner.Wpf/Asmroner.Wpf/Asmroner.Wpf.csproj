<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\..\Asmroner.Backend\Asmroner.Application\Asmroner.Application.csproj" />
        <ProjectReference Include="..\..\Asmroner.Backend\Asmroner.Infrastructure\Asmroner.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Asmroner.Backend\Asmroner.Core\Asmroner.Core.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Version>0.5.5</Version>
        <AssemblyVersion>0.5.5.0</AssemblyVersion>
        <FileVersion>0.5.5.0</FileVersion>
        <InformationalVersion>0.5.5</InformationalVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
        <PackageReference Include="NLog.Extensions.Logging" Version="6.1.2" />
    </ItemGroup>

    <ItemGroup>
        <None Update="config.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
