<Window x:Class="Asmroner.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Asmroner.Wpf"
        mc:Ignorable="d"
        Title="Asmroner v0.4.2"
        Height="720"
        Width="1280"
        MinHeight="720"
        MinWidth="1280">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1F2937"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="White"
                       Text="初始化中..."/>
        </Border>

        <TabControl x:Name="MainTabControl"
                    Grid.Row="1">
            <TabItem x:Name="DashboardTab"
                     Header="Search">
                <ContentControl x:Name="DashboardHost"/>
            </TabItem>
            <TabItem x:Name="DownloadTab"
                     Header="Download">
                <ContentControl x:Name="DownloadHost"/>
            </TabItem>
            <TabItem x:Name="SettingsTab"
                     Header="Settings">
                <ContentControl x:Name="SettingsHost"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
