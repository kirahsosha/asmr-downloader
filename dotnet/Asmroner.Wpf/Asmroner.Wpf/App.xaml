<Application x:Class="Asmroner.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Asmroner.Wpf">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ShellResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="StatusInfoPanelBackgroundBrush"
                             Color="#FFF0F6FC"/>
            <SolidColorBrush x:Key="StatusInfoPanelBorderBrush"
                             Color="#FFD5E3F2"/>
            <SolidColorBrush x:Key="StatusInfoTextBrush"
                             Color="#FF355A7A"/>
            <SolidColorBrush x:Key="StatusInfoMutedTextBrush"
                             Color="#FF5A7086"/>

            <Style x:Key="StatusInfoPanelStyle"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="{StaticResource StatusInfoPanelBackgroundBrush}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource StatusInfoPanelBorderBrush}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="8"/>
                <Setter Property="Padding"
                        Value="10,8"/>
                <Setter Property="Margin"
                        Value="0,10,0,0"/>
            </Style>

            <Style x:Key="StatusInfoTextStyle"
                   TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="{StaticResource StatusInfoTextBrush}"/>
                <Setter Property="TextWrapping"
                        Value="Wrap"/>
            </Style>

            <Style x:Key="StatusInfoMutedTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource StatusInfoTextStyle}">
                <Setter Property="Foreground"
                        Value="{StaticResource StatusInfoMutedTextBrush}"/>
            </Style>

            <DataTemplate x:Key="PageStatePresenterTemplate">
                <StackPanel>
                    <Border x:Name="BusyPanel"
                            Style="{StaticResource PageStateBusyPanelStyle}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ProgressBar Grid.Column="0"
                                         Width="72"
                                         Height="12"
                                         Margin="0,0,12,0"
                                         VerticalAlignment="Center"
                                         IsIndeterminate="True"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FF24507A"
                                           Text="正在处理"/>
                                <TextBlock Foreground="#FF4B5563"
                                           Text="{Binding BusyMessage}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="EmptyPanel"
                            Style="{StaticResource PageStateEmptyPanelStyle}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FF24507A"
                                       Text="{Binding EmptyTitle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#FF4B5563"
                                       Text="{Binding EmptyDescription}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}"
                                 Value="True">
                        <Setter TargetName="BusyPanel"
                                Property="Visibility"
                                Value="Visible"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsBusy}"
                                       Value="False"/>
                            <Condition Binding="{Binding IsEmptyVisible}"
                                       Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="EmptyPanel"
                                Property="Visibility"
                                Value="Visible"/>
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
