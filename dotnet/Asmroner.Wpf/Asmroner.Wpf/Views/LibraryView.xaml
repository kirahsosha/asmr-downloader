<UserControl x:Class="Asmroner.Wpf.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:library="clr-namespace:Asmroner.Core.Library;assembly=Asmroner.Core"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="ShellBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Offset="0"
                          Color="#FFF6FBFF"/>
            <GradientStop Offset="1"
                          Color="#FFEFF6FF"/>
        </LinearGradientBrush>

        <Style x:Key="CardBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush"
                    Value="#FFE3ECF7"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="14"/>
            <Setter Property="Margin"
                    Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#FF1E2A3A"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="Padding"
                    Value="10,4"/>
            <Setter Property="BorderBrush"
                    Value="#FFD6E3F2"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Background"
                    Value="#FFFFFFFF"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Padding"
                    Value="12,5"/>
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="Margin"
                    Value="0,0,8,6"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#FF3D8DFF"/>
            <Setter Property="BorderBrush"
                    Value="#FF3D8DFF"/>
        </Style>

        <Style x:Key="LightActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground"
                    Value="#FF24507A"/>
            <Setter Property="Background"
                    Value="#FFE8F2FF"/>
            <Setter Property="BorderBrush"
                    Value="#FFD2E5FF"/>
        </Style>

        <Style x:Key="ResultGridHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#FFE9F3FF"/>
            <Setter Property="Foreground"
                    Value="#FF24507A"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="BorderBrush"
                    Value="#FFD7E8FA"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="ResultGridStyle"
               TargetType="DataGrid">
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="GridLinesVisibility"
                    Value="None"/>
            <Setter Property="RowBackground"
                    Value="#FFFDFEFF"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#FFF3F8FE"/>
            <Setter Property="HeadersVisibility"
                    Value="Column"/>
            <Setter Property="CanUserReorderColumns"
                    Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="ColumnHeaderStyle"
                    Value="{StaticResource ResultGridHeaderStyle}"/>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type library:LibraryFileItem}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayName}"/>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="12"
          Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="2,2,2,0">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FF1E2A3A"
                       Text="Library"/>
            <TextBlock Margin="0,8,0,12"
                       Foreground="#FF5A6A80"
                       Text="阶段 6 第三批：资源库异常兼容与系统默认程序打开补强。"/>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="筛选与分页"/>
                    <WrapPanel>
                        <TextBox x:Name="KeywordTextBox"
                                 Width="280"
                                 Margin="0,0,8,6"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 ToolTip="按 SourceId、标题、标签、日期或目录路径筛选"/>

                        <CheckBox x:Name="SubtitleOnlyCheckBox"
                                  Margin="0,0,12,6"
                                  VerticalAlignment="Center"
                                  Content="仅显示带字幕作品"/>

                        <CheckBox x:Name="AudioOnlyCheckBox"
                                  Margin="0,0,12,6"
                                  VerticalAlignment="Center"
                                  Content="仅显示含音频作品"
                                  IsChecked="True"/>

                        <Button x:Name="RefreshLibraryButton"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="OnRefreshLibraryClicked"
                                Content="刷新资源库"/>

                        <Button x:Name="PrevPageButton"
                                Style="{StaticResource LightActionButtonStyle}"
                                Click="OnPrevPageClicked"
                                Content="上一页"/>

                        <Button x:Name="NextPageButton"
                                Style="{StaticResource LightActionButtonStyle}"
                                Click="OnNextPageClicked"
                                Content="下一页"/>
                    </WrapPanel>

                    <TextBlock x:Name="PageInfoTextBlock"
                               Foreground="#FF5A6A80"
                               Text="第 1/1 页 · 共 0 个作品"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="作品列表"/>
                    <DataGrid x:Name="LibraryWorksDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="OnLibrarySelectionChanged"
                              Style="{StaticResource ResultGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding SourceId}"
                                                Header="SourceId"
                                                Width="120"/>
                            <DataGridTextColumn Binding="{Binding Title}"
                                                Header="标题"
                                                Width="*"/>
                            <DataGridTextColumn Binding="{Binding Release}"
                                                Header="日期"
                                                Width="92"/>
                            <DataGridCheckBoxColumn Binding="{Binding HasSubtitle}"
                                                    Header="字幕"
                                                    Width="54"/>
                            <DataGridTextColumn Binding="{Binding AudioFileCount}"
                                                Header="音频"
                                                Width="64"/>
                            <DataGridTextColumn Binding="{Binding TotalFileCount}"
                                                Header="文件"
                                                Width="64"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="作品详情"/>
                        <TextBlock x:Name="WorkDetailsTextBlock"
                                   Foreground="#FF4B5563"
                                   Text="请选择左侧作品查看详情。"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="文件树与系统打开"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="LoadContextButton"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="OnLoadContextClicked"
                                    Content="载入/切换文件"/>
                            <Button x:Name="PlayButton"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="OnPlayClicked"
                                    Content="播放"/>
                            <Button x:Name="ClearContextButton"
                                    Style="{StaticResource LightActionButtonStyle}"
                                    Click="OnClearContextClicked"
                                    Content="清空上下文"/>
                        </WrapPanel>

                        <TreeView x:Name="FileTreeView"
                                  Height="220"
                                  Margin="0,0,0,8"
                                  SelectedItemChanged="OnFileTreeSelectedItemChanged"/>

                        <TextBlock x:Name="ContextTextBlock"
                                   Foreground="#FF4B5563"
                                   Text="尚未载入任何可播放媒体文件。"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Style="{StaticResource CardBorderStyle}">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#FF4B5563"
                       Text="资源库尚未刷新。"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>