<UserControl x:Class="Asmroner.Wpf.Views.DownloadView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="CardBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource ShellCardBorderBaseStyle}">
            <Setter Property="CornerRadius"
                    Value="12"/>
            <Setter Property="BorderBrush"
                    Value="#FFD8E6F4"/>
            <Setter Property="Padding"
                    Value="12"/>
            <Setter Property="Margin"
                    Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#FF2C6FB7"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="10,6"/>
            <Setter Property="Margin"
                    Value="6,0,0,0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonRoot"
                                        Property="Background"
                                        Value="#FF245E9C"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonRoot"
                                        Property="Background"
                                        Value="#FF1F4E82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonRoot"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background"
                    Value="#FF4D86C6"/>
        </Style>

        <Style x:Key="FieldTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource ShellFieldTextBoxBaseStyle}">
            <Setter Property="Padding"
                    Value="8,5"/>
            <Setter Property="BorderBrush"
                    Value="#FFADC6DF"/>
            <Setter Property="Background"
                    Value="#FFFBFDFF"/>
        </Style>

        <Style x:Key="MutedLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource ShellMutedLabelStyle}">
            <Setter Property="Foreground"
                    Value="#FF35506C"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>

        <Style x:Key="TaskGridHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#FFE6F0FB"/>
            <Setter Property="Foreground"
                    Value="#FF224E7D"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="BorderBrush"
                    Value="#FFD1E1F1"/>
            <Setter Property="BorderThickness"
                    Value="1,1,1,1"/>
        </Style>

        <Style x:Key="TaskGridCellStyle"
               TargetType="DataGridCell">
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12"
          Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Background="#FF2A5F96"
                BorderThickness="0"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="Download Center"/>
                <TextBlock Margin="0,6,0,0"
                           Foreground="#FFD7E8FA"
                           Text="下载队列执行与任务状态展示"/>
            </StackPanel>
        </Border>

        <!-- 行1：单个/批量 RJID 输入 -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MutedLabelStyle}"
                           Text="RJID"/>
                <TextBox x:Name="SingleSourceIdTextBox"
                         Width="120"
                         Margin="8,0,0,6"
                         Style="{StaticResource FieldTextBoxStyle}"
                         TextChanged="OnSingleSourceIdTextChanged"/>
                <Button x:Name="AddSingleButton"
                        Width="112"
                        Margin="6,0,12,6"
                        Style="{StaticResource LightActionButtonStyle}"
                        Click="OnAddSingleClicked"
                        Content="加入单个下载"/>

                <TextBlock Style="{StaticResource MutedLabelStyle}"
                           Text="批量 RJID"/>
                <TextBox x:Name="BatchSourceIdsTextBox"
                         Width="300"
                         Margin="8,0,0,6"
                         Style="{StaticResource FieldTextBoxStyle}"
                         TextChanged="OnBatchSourceIdsTextChanged"
                         ToolTip="支持逗号、空格、分号或换行分隔"/>
                <Button x:Name="AddBatchButton"
                        Width="112"
                        Margin="6,0,6,6"
                        Style="{StaticResource LightActionButtonStyle}"
                        Click="OnAddBatchClicked"
                        Content="加入批量下载"/>
                <Button x:Name="ImportFileButton"
                        Width="100"
                        Margin="6,0,6,6"
                        Style="{StaticResource LightActionButtonStyle}"
                        Click="OnImportFileClicked"
                        Content="从文件导入"
                        ToolTip="导入从 Search 页面导出的 CSV 或 JSON 文件，将其中的作品加入下载队列"/>
                <Button x:Name="ImportFavoritesButton"
                        Width="112"
                        Margin="6,0,6,6"
                        Style="{StaticResource LightActionButtonStyle}"
                        Click="OnImportFavoritesClicked"
                        Content="从收藏夹导入"
                        ToolTip="从 SQLite 收藏夹读取作品并加入下载队列"/>
            </WrapPanel>
        </Border>

        <!-- 行2：文件筛选 -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource MutedLabelStyle}"
                           Text="文件筛选"/>
                <TextBox x:Name="FilterTextBox"
                         Width="360"
                         Margin="8,0,0,0"
                         Style="{StaticResource FieldTextBoxStyle}"
                         ToolTip="分号分隔；无前缀或 + 为必含条件，- 为排除条件。例：+voice;-cover"/>
                <CheckBox x:Name="HdAudioOnlyCheckBox"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Content="只下载高清音频"
                          ToolTip="同时存在高清音频如wav/flac和低清音频mp3时，只下载高清音频"/>
                <CheckBox x:Name="QueueTranslationCheckBox"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Content="加入翻译作品"
                          ToolTip="加入下载队列时按 简体中文 → 繁体中文 → 日本語 的优先级选择版本"/>
            </StackPanel>
        </Border>

        <!-- 行3：操作按钮 -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <WrapPanel DockPanel.Dock="Left"
                           VerticalAlignment="Center">
                    <Button x:Name="StartSelectedButton"
                            Width="136"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0"
                            Click="OnStartSelectedClicked"
                            Content="立即下载选中任务"/>
                    <Button x:Name="RunQueueButton"
                            Width="112"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OnRunQueueClicked"
                            Content="执行下载队列"/>
                    <Button x:Name="RefreshButton"
                            Width="112"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnRefreshClicked"
                            Content="刷新任务列表"/>
                    <Button x:Name="ClearTaskListButton"
                            Width="112"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnClearTaskListClicked"
                            Content="清空任务列表"/>
                    <Button x:Name="CancelButton"
                            Width="112"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnCancelClicked"
                            Content="取消选中任务"/>
                    <Button x:Name="RetryButton"
                            Width="112"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnRetryClicked"
                            Content="重试失败任务"/>
                    <Button x:Name="OpenDownloadDirectoryButton"
                            Width="112"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnOpenDownloadDirectoryClicked"
                            Content="打开下载目录"/>
                </WrapPanel>

                <Border DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="10,6"
                        Background="#FFF0F7FF"
                        CornerRadius="16">
                    <TextBlock x:Name="QueueCountTextBlock"
                               Foreground="#FF1E5A93"
                               FontWeight="SemiBold"
                               Text="待下载队列：0"/>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,0"
                Padding="0"
                BorderBrush="#FFBFD3E8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0"
                                Margin="12,12,12,0"
                                Content="{Binding PageState, ElementName=Root}"
                                ContentTemplate="{StaticResource PageStatePresenterTemplate}"/>

                <DataGrid x:Name="TaskGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserReorderColumns="True"
                          SelectionChanged="OnTaskSelectionChanged"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="None"
                          RowBackground="#FFFDFEFF"
                          AlternatingRowBackground="#FFF3F8FE"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource TaskGridHeaderStyle}"
                          CellStyle="{StaticResource TaskGridCellStyle}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="110"
                                            Header="作品ID"
                                            Binding="{Binding SourceId}"/>
                        <DataGridTextColumn Width="300"
                                            Header="标题"
                                            Binding="{Binding Title}"/>
                        <DataGridTextColumn Width="50"
                                            Header="状态"
                                            CanUserResize="False"
                                            Binding="{Binding StatusText}"
                                            SortMemberPath="StatusSortOrder"/>
                        <DataGridTextColumn Width="96"
                                            Header="进度"
                                            Binding="{Binding ProgressText}"/>
                        <DataGridTextColumn Width="320"
                                            Header="下载目录"
                                            Binding="{Binding TargetDirectory}"/>
                        <DataGridTextColumn Width="300"
                                            Header="错误信息"
                                            Binding="{Binding ErrorMessage}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Style="{StaticResource StatusInfoPanelStyle}">
            <TextBlock x:Name="StatusTextBlock"
                       Style="{StaticResource StatusInfoTextStyle}"
                       Text="等待执行下载队列。"/>
        </Border>
    </Grid>
</UserControl>
