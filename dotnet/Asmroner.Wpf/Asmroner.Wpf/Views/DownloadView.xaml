<UserControl x:Class="Asmroner.Wpf.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#FFF7FBFF"
                          Offset="0"/>
            <GradientStop Color="#FFEAF4FF"
                          Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CardBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#FFFFFFFF"/>
            <Setter Property="CornerRadius"
                    Value="12"/>
            <Setter Property="BorderBrush"
                    Value="#FFD8E6F4"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="12"/>
            <Setter Property="Margin"
                    Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#FF2C6FB7"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="10,6"/>
            <Setter Property="Margin"
                    Value="6,0,0,0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonRoot"
                                        Property="Background"
                                        Value="#FF245E9C"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonRoot"
                                        Property="Background"
                                        Value="#FF1F4E82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonRoot"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background"
                    Value="#FF4D86C6"/>
        </Style>

        <Style x:Key="FieldTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Padding"
                    Value="8,5"/>
            <Setter Property="BorderBrush"
                    Value="#FFADC6DF"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Background"
                    Value="#FFFBFDFF"/>
        </Style>

        <Style x:Key="MutedLabelStyle"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Foreground"
                    Value="#FF35506C"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12"
          Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Background="#FF2A5F96"
                BorderThickness="0"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="Download Center"/>
                <TextBlock Margin="0,6,0,0"
                           Foreground="#FFD7E8FA"
                           Text="下载队列执行与任务状态展示"/>
            </StackPanel>
        </Border>

        <!-- 行1：单个/批量 RJID 输入 -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MutedLabelStyle}"
                           Text="RJID"/>
                <TextBox x:Name="SingleSourceIdTextBox"
                         Width="120"
                         Margin="8,0,0,6"
                         Style="{StaticResource FieldTextBoxStyle}"
                         TextChanged="OnSingleSourceIdTextChanged"/>
                <Button x:Name="AddSingleButton"
                        Width="112"
                        Margin="6,0,12,6"
                        Style="{StaticResource LightActionButtonStyle}"
                        Click="OnAddSingleClicked"
                        Content="加入单个下载"/>

                <TextBlock Style="{StaticResource MutedLabelStyle}"
                           Text="批量 RJID"/>
                <TextBox x:Name="BatchSourceIdsTextBox"
                         Width="300"
                         Margin="8,0,0,6"
                         Style="{StaticResource FieldTextBoxStyle}"
                         TextChanged="OnBatchSourceIdsTextChanged"
                         ToolTip="支持逗号、空格、分号或换行分隔"/>
                <Button x:Name="AddBatchButton"
                        Width="112"
                        Margin="6,0,6,6"
                        Style="{StaticResource LightActionButtonStyle}"
                        Click="OnAddBatchClicked"
                        Content="加入批量下载"/>
                <Button x:Name="RunQueueButton"
                        Width="142"
                        Margin="6,0,0,6"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OnRunQueueClicked"
                        Content="执行下载队列"/>
            </WrapPanel>
        </Border>

        <!-- 行2：文件筛选 -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource MutedLabelStyle}"
                           Text="文件筛选"/>
                <TextBox x:Name="FilterTextBox"
                         Width="360"
                         Margin="8,0,0,0"
                         Style="{StaticResource FieldTextBoxStyle}"
                         ToolTip="分号分隔；无前缀或 + 为必含条件，- 为排除条件。例：+voice;-cover"/>
            </StackPanel>
        </Border>

        <!-- 行3：操作按钮 -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <WrapPanel DockPanel.Dock="Left"
                           VerticalAlignment="Center">
                    <Button x:Name="StartSelectedButton"
                            Width="162"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0"
                            Click="OnStartSelectedClicked"
                            Content="立即下载选中任务"/>
                    <Button x:Name="RefreshButton"
                            Width="120"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnRefreshClicked"
                            Content="刷新任务列表"/>
                    <Button x:Name="CancelButton"
                            Width="120"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnCancelClicked"
                            Content="取消选中任务"/>
                    <Button x:Name="RetryButton"
                            Width="120"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnRetryClicked"
                            Content="重试失败任务"/>
                    <Button x:Name="RetryAllFailedButton"
                            Width="150"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnRetryAllFailedClicked"
                            Content="重试全部失败任务"/>
                    <Button x:Name="OpenDownloadDirectoryButton"
                            Width="126"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnOpenDownloadDirectoryClicked"
                            Content="打开下载目录"/>
                </WrapPanel>

                <Border DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="10,6"
                        Background="#FFF0F7FF"
                        CornerRadius="16">
                    <TextBlock x:Name="QueueCountTextBlock"
                               Foreground="#FF1E5A93"
                               FontWeight="SemiBold"
                               Text="待下载队列：0"/>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,0"
                Padding="0"
                BorderBrush="#FFBFD3E8">
            <DataGrid x:Name="TaskGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionChanged="OnTaskSelectionChanged"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="None"
                      RowBackground="#FFFDFEFF"
                      AlternatingRowBackground="#FFF3F8FE"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="#FFE6F0FB"/>
                        <Setter Property="Foreground"
                                Value="#FF224E7D"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Padding"
                                Value="8,6"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding"
                                Value="8,6"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="100"
                                        Header="作品ID"
                                        Binding="{Binding SourceId}"/>
                    <DataGridTextColumn Width="220"
                                        Header="标题"
                                        Binding="{Binding Title}"/>
                    <DataGridTextColumn Width="68"
                                        Header="状态"
                                        Binding="{Binding StatusText}"/>
                    <DataGridTextColumn Width="85"
                                        Header="进度"
                                        Binding="{Binding ProgressText}"/>
                    <DataGridTextColumn Width="240"
                                        Header="下载目录"
                                        Binding="{Binding TargetDirectory}"/>
                    <DataGridTextColumn Width="220"
                                        Header="错误信息"
                                        Binding="{Binding ErrorMessage}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5"
                Margin="0,10,0,0"
                Background="#FFF0F6FC"
                CornerRadius="8"
                Padding="10,8">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#FF365A7A"
                       Text="等待执行下载队列。"/>
        </Border>
    </Grid>
</UserControl>
