<UserControl x:Class="Asmroner.Wpf.Views.SearchView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="CardBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource ShellCardBorderBaseStyle}">
            <Setter Property="Margin"
                    Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource ShellSectionTitleStyle}"/>

        <Style x:Key="MutedLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource ShellMutedLabelStyle}"/>

        <Style x:Key="FieldTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource ShellFieldTextBoxBaseStyle}"/>

        <Style x:Key="FieldComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource ShellFieldComboBoxBaseStyle}"/>

        <Style TargetType="ComboBoxItem"
               BasedOn="{StaticResource ShellComboBoxItemStyle}"/>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ShellActionButtonBaseStyle}">
            <Setter Property="Margin"
                    Value="0,0,8,6"/>
        </Style>

        <Style x:Key="LightActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ShellLightActionButtonBaseStyle}">
            <Setter Property="Margin"
                    Value="0,0,8,6"/>
        </Style>

        <Style x:Key="ResultGridHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#FFE9F3FF"/>
            <Setter Property="Foreground"
                    Value="#FF24507A"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="BorderBrush"
                    Value="#FFD7E8FA"/>
            <Setter Property="BorderThickness"
                    Value="1,1,1,1"/>
        </Style>

        <Style x:Key="ResultGridStyle"
               TargetType="DataGrid">
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="GridLinesVisibility"
                    Value="None"/>
            <Setter Property="RowBackground"
                    Value="#FFFDFEFF"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#FFF3F8FE"/>
            <Setter Property="HeadersVisibility"
                    Value="Column"/>
            <Setter Property="CanUserReorderColumns"
                    Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="ColumnHeaderStyle"
                    Value="{StaticResource ResultGridHeaderStyle}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12"
          Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="2,2,2,0">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FF1E2A3A"
                       Text="Search"/>
            <TextBlock Margin="0,8,0,12"
                       Foreground="#FF5A6A80"
                       Text="支持基础关键词、高级筛选、分页、导出与入队。"/>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="检索与动作"/>

                    <WrapPanel>
                        <TextBox x:Name="QueryTextBox"
                                 Width="340"
                                 Margin="0,0,8,6"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 ToolTip="基础关键词，支持逗号分隔"/>

                        <Button x:Name="SearchButton"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="OnSearchClicked"
                                Content="搜索"/>

                        <Button x:Name="ExportButton"
                                Style="{StaticResource LightActionButtonStyle}"
                                Click="OnExportClicked"
                                Content="导出到文件"/>

                        <Button x:Name="QueueButton"
                                Style="{StaticResource LightActionButtonStyle}"
                                Click="OnQueueClicked"
                                Content="加入下载队列"/>

                        <Button x:Name="FavoriteButton"
                                Style="{StaticResource LightActionButtonStyle}"
                                Click="OnFavoriteClicked"
                                Content="收藏作品"/>

                        <Button x:Name="ClearButton"
                                Style="{StaticResource LightActionButtonStyle}"
                                Click="OnClearClicked"
                                Content="清空"/>

                        <Button x:Name="QueryHotButton"
                                Style="{StaticResource LightActionButtonStyle}"
                                Click="OnQueryHotClicked"
                                Content="查询热门作品"/>
                    </WrapPanel>

                    <WrapPanel Margin="0,2,0,0">
                        <TextBlock Style="{StaticResource MutedLabelStyle}"
                                   Text="排序:"/>
                        <ComboBox x:Name="OrderComboBox"
                                  Width="96"
                                  Margin="0,0,12,6"
                                  Style="{StaticResource FieldComboBoxStyle}"
                                  SelectionChanged="OnOrderChanged"
                                  SelectedIndex="0">
                            <ComboBoxItem Tag="release"
                                          Content="日期"/>
                            <ComboBoxItem Tag="dl_count"
                                          Content="销量"/>
                            <ComboBoxItem Tag="create_date"
                                          Content="创建时间"/>
                            <ComboBoxItem Tag="price"
                                          Content="价格"/>
                            <ComboBoxItem Tag="rate_average_2dp"
                                          Content="评分"/>
                            <ComboBoxItem Tag="id"
                                          Content="编号"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource MutedLabelStyle}"
                                   Text="方向:"/>
                        <ComboBox x:Name="SortComboBox"
                                  Width="96"
                                  Margin="0,0,12,6"
                                  Style="{StaticResource FieldComboBoxStyle}"
                                  SelectionChanged="OnSortChanged"
                                  SelectedIndex="0">
                            <ComboBoxItem Tag="desc"
                                          Content="降序"/>
                            <ComboBoxItem Tag="asc"
                                          Content="升序"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource MutedLabelStyle}"
                                   Text="字幕:"/>
                        <ComboBox x:Name="SubtitleComboBox"
                                  Width="96"
                                  Margin="0,0,12,6"
                                  Style="{StaticResource FieldComboBoxStyle}"
                                  SelectionChanged="OnSubtitleChanged"
                                  SelectedIndex="0">
                            <ComboBoxItem Tag="0"
                                          Content="不限"/>
                            <ComboBoxItem Tag="1"
                                          Content="仅有字幕"/>
                        </ComboBox>

                        <CheckBox x:Name="IncludeTranslationCheckBox"
                                  Margin="0,6,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="True"
                                  Content="包含翻译作品"/>

                        <CheckBox x:Name="QueueTranslationCheckBox"
                                  Margin="10,6,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="True"
                                  Content="加入翻译作品"
                                  ToolTip="加入下载队列时按 简体中文 → 繁体中文 → 日本語 的优先级选择版本"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}">
            <Expander Margin="0"
                      Header="高级筛选"
                      IsExpanded="False"
                      Expanded="OnAdvancedFilterExpanded">
                <Grid Margin="8,10,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,6,6"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="tag"/>
                    <TextBox x:Name="TagTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,0,8,6"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                    <CheckBox x:Name="TagExcludeCheckBox"
                              Grid.Row="0"
                              Grid.Column="2"
                              Margin="0,0,12,6"
                              VerticalAlignment="Center"
                              Content="反选"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="3"
                               Margin="0,0,6,6"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="circle"/>
                    <TextBox x:Name="CircleTextBox"
                             Grid.Row="0"
                             Grid.Column="4"
                             Margin="0,0,8,6"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                    <CheckBox x:Name="CircleExcludeCheckBox"
                              Grid.Row="0"
                              Grid.Column="5"
                              Margin="0,0,0,6"
                              VerticalAlignment="Center"
                              Content="反选"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,6,6"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="va"/>
                    <TextBox x:Name="VaTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,0,8,6"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                    <CheckBox x:Name="VaExcludeCheckBox"
                              Grid.Row="1"
                              Grid.Column="2"
                              Margin="0,0,12,6"
                              VerticalAlignment="Center"
                              Content="反选"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="3"
                               Margin="0,0,6,6"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="duration"/>
                    <TextBox x:Name="DurationTextBox"
                             Grid.Row="1"
                             Grid.Column="4"
                             Margin="0,0,8,6"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                    <CheckBox x:Name="DurationExcludeCheckBox"
                              Grid.Row="1"
                              Grid.Column="5"
                              Margin="0,0,0,6"
                              VerticalAlignment="Center"
                              Content="反选"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,0,6,6"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="rate"/>
                    <TextBox x:Name="RateTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,0,8,6"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                    <CheckBox x:Name="RateExcludeCheckBox"
                              Grid.Row="2"
                              Grid.Column="2"
                              Margin="0,0,12,6"
                              VerticalAlignment="Center"
                              Content="反选"/>
                    <TextBlock Grid.Row="2"
                               Grid.Column="3"
                               Margin="0,0,6,6"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="price"/>
                    <TextBox x:Name="PriceTextBox"
                             Grid.Row="2"
                             Grid.Column="4"
                             Margin="0,0,8,6"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                    <CheckBox x:Name="PriceExcludeCheckBox"
                              Grid.Row="2"
                              Grid.Column="5"
                              Margin="0,0,0,6"
                              VerticalAlignment="Center"
                              Content="反选"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Margin="0,0,6,6"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="sell"/>
                    <TextBox x:Name="SellTextBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             Margin="0,0,8,6"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                    <CheckBox x:Name="SellExcludeCheckBox"
                              Grid.Row="3"
                              Grid.Column="2"
                              Margin="0,0,12,6"
                              VerticalAlignment="Center"
                              Content="反选"/>
                    <TextBlock Grid.Row="3"
                               Grid.Column="3"
                               Margin="0,0,6,6"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="age"/>
                    <TextBox x:Name="AgeTextBox"
                             Grid.Row="3"
                             Grid.Column="4"
                             Margin="0,0,8,6"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                    <CheckBox x:Name="AgeExcludeCheckBox"
                              Grid.Row="3"
                              Grid.Column="5"
                              Margin="0,0,0,6"
                              VerticalAlignment="Center"
                              Content="反选"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Margin="0,0,6,0"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="lang"/>
                    <TextBox x:Name="LangTextBox"
                             Grid.Row="4"
                             Grid.Column="1"
                             Margin="0,0,8,0"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                    <CheckBox x:Name="LangExcludeCheckBox"
                              Grid.Row="4"
                              Grid.Column="2"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Content="反选"/>
                </Grid>
            </Expander>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0"
                                Margin="0,0,0,8"
                                Content="{Binding PageState, ElementName=Root}"
                                ContentTemplate="{StaticResource PageStatePresenterTemplate}"/>

                <DataGrid x:Name="ResultsGrid"
                          Grid.Row="1"
                          Margin="0,0,0,8"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="True"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          PreviewMouseRightButtonDown="OnResultsGridPreviewMouseRightButtonDown"
                          Style="{StaticResource ResultGridStyle}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="加入下载队列"
                                      Click="OnContextMenuQueueClicked"/>
                            <MenuItem Header="导出全部任务到文件"
                                      Click="OnContextMenuExportAllClicked"/>
                            <MenuItem Header="导出选中任务到文件"
                                      Click="OnContextMenuExportSelectedClicked"/>
                            <MenuItem Header="在浏览器打开"
                                      Click="OnContextMenuOpenWorkPageClicked"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="120"
                                            Header="作品ID"
                                            Binding="{Binding SourceId}"/>
                        <DataGridTextColumn Width="360"
                                            Header="标题"
                                            Binding="{Binding Title}"/>
                        <DataGridCheckBoxColumn Width="42"
                                                Header="字幕"
                                                CanUserResize="False"
                                                Binding="{Binding HasSubtitle}"/>
                        <DataGridTextColumn Width="75"
                                            Header="日期"
                                            CanUserResize="False"
                                            Binding="{Binding Release}"/>
                        <DataGridTextColumn Width="260"
                                            Header="标签"
                                            Binding="{Binding Tags}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PrevPageButton"
                            Grid.Column="0"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnPrevPageClicked"
                            Content="上一页"/>

                    <Button x:Name="NextPageButton"
                            Grid.Column="1"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnNextPageClicked"
                            Content="下一页"/>

                    <TextBlock Grid.Column="2"
                               Margin="0,0,6,0"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="页码"/>

                    <TextBox x:Name="CurrentPageTextBox"
                             Grid.Column="3"
                             Width="60"
                             Margin="0,0,8,0"
                             Style="{StaticResource FieldTextBoxStyle}"
                             Text="1"/>

                    <Button x:Name="GoPageButton"
                            Grid.Column="4"
                            Style="{StaticResource LightActionButtonStyle}"
                            Click="OnGoPageClicked"
                            Content="跳页"/>

                    <ComboBox x:Name="PageSizeComboBox"
                              Grid.Column="5"
                              Width="80"
                              Margin="0,0,8,0"
                              Style="{StaticResource FieldComboBoxStyle}"
                              SelectionChanged="OnPageSizeChanged">
                        <ComboBoxItem IsSelected="True"
                                      Content="20"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                    </ComboBox>

                    <TextBlock x:Name="PageInfoTextBlock"
                               Grid.Column="6"
                               VerticalAlignment="Center"
                               Foreground="#FF4A5E76"
                               Text="第 1/1 页，总计 0 条"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="2,2,0,0"
                Style="{StaticResource StatusInfoPanelStyle}">
            <TextBlock x:Name="StatusTextBlock"
                       Style="{StaticResource StatusInfoTextStyle}"
                       Text="请输入关键词并执行搜索。"/>
        </Border>
    </Grid>
</UserControl>