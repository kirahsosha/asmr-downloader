<UserControl x:Class="Asmroner.Wpf.Views.SyncView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <Style x:Key="CardBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource ShellCardBorderBaseStyle}">
            <Setter Property="Margin"
                    Value="0,0,0,10"/>
        </Style>

        <Style x:Key="StatsCardBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource ShellCardBorderBaseStyle}">
            <Setter Property="Padding"
                    Value="12"/>
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource ShellSectionTitleStyle}"/>

        <Style x:Key="MutedLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource ShellMutedLabelStyle}"/>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ShellActionButtonBaseStyle}">
            <Setter Property="Margin"
                    Value="0,0,12,8"/>
            <Setter Property="Width"
                    Value="180"/>
            <Setter Property="Height"
                    Value="32"/>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ShellLightActionButtonBaseStyle}">
            <Setter Property="Margin"
                    Value="0,0,12,8"/>
            <Setter Property="Height"
                    Value="32"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12"
          Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="2,2,2,0">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FF1E2A3A"
                       Text="Sync"/>
            <TextBlock Margin="0,8,0,12"
                       Foreground="#FF5A6A80"
                       Text="元数据同步、下载同步、失败重试与统计报表。"/>
        </StackPanel>

        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,6">
            <Button x:Name="SyncMetadataButton"
                    Style="{StaticResource ActionButtonStyle}"
                    Content="开始同步元数据"
                    Click="OnSyncMetadataClicked"/>
            <Button x:Name="SyncDownloadButton"
                    Style="{StaticResource ActionButtonStyle}"
                    Content="开始同步下载"
                    Click="OnSyncDownloadClicked"/>
            <Button x:Name="RetryFailedButton"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Width="140"
                    Content="重试失败项"
                    Click="OnRetryFailedClicked"/>
            <Button x:Name="ExportFailedButton"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Width="140"
                    Content="导出失败记录"
                    Click="OnExportFailedClicked"/>
            <Button x:Name="ExportCompletedButton"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Width="140"
                    Content="导出成功记录"
                    Click="OnExportCompletedClicked"/>
            <Button x:Name="RefreshStatusButton"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Width="120"
                    Content="刷新统计"
                    Click="OnRefreshStatusClicked"/>
        </WrapPanel>

        <ContentControl Grid.Row="2"
                        Margin="0,0,0,12"
                        Content="{Binding PageState, ElementName=Root}"
                        ContentTemplate="{StaticResource PageStatePresenterTemplate}"/>

        <StackPanel Grid.Row="3"
                    Margin="0,0,0,6">
            <TextBlock x:Name="CurrentCountTextBlock"
                       Margin="0,0,0,6"
                       FontWeight="SemiBold"
                       Text="本地元数据：0 条（字幕 0 条）"/>
            <TextBlock x:Name="DownloadCountTextBlock"
                       FontWeight="SemiBold"
                       Text="同步下载：已完成 0 项，失败 0 项，待处理 0 项，队列中 0 项，已落盘 0 B"/>
        </StackPanel>

        <Grid Grid.Row="4"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,8"
                    Style="{StaticResource StatsCardBorderStyle}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="元数据统计"/>
                    <TextBlock x:Name="MetadataBreakdownTextBlock"
                               Margin="0,6,0,0"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="总量 0 条，字幕 0 条，无字幕 0 条"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0,0,8"
                    Style="{StaticResource StatsCardBorderStyle}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="完成统计"/>
                    <TextBlock x:Name="CompletedBreakdownTextBlock"
                               Margin="0,6,0,0"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="已完成 0 条，字幕 0 条，无字幕 0 条，已落盘 0 B"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Style="{StaticResource StatsCardBorderStyle}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="积压统计"/>
                    <TextBlock x:Name="BacklogBreakdownTextBlock"
                               Margin="0,6,0,0"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="失败 0 条，待处理 0 条，未建同步记录 0 条"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Style="{StaticResource StatsCardBorderStyle}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="同步进度"/>
                    <TextBlock x:Name="ProgressBreakdownTextBlock"
                               Margin="0,6,0,0"
                               Style="{StaticResource MutedLabelStyle}"
                               Text="总进度 0.00%，字幕 0.00%，无字幕 0.00%"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="5"
                Margin="0,0,0,12"
                Style="{StaticResource StatusInfoPanelStyle}">
            <StackPanel>
                <TextBlock x:Name="LastSyncTextBlock"
                           Margin="0,0,0,6"
                           Style="{StaticResource StatusInfoMutedTextStyle}"
                           Text="最近更新：元数据 暂无；同步记录 暂无"/>
                <TextBlock x:Name="StatusTextBlock"
                           Margin="0,0,0,6"
                           Style="{StaticResource StatusInfoTextStyle}"
                           Text="同步状态：点击同步、重试、导出或刷新统计后，这里会显示元数据同步状态。"/>
                <TextBlock x:Name="DownloadStatusTextBlock"
                           Style="{StaticResource StatusInfoTextStyle}"
                           Text="下载状态：点击同步、重试、导出或刷新统计后，这里会显示同步下载状态。"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="6"
                Style="{StaticResource StatusInfoPanelStyle}">
            <TextBox x:Name="DetailsTextBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Text="点击同步、重试、导出或刷新统计后，这里会显示本次执行摘要。"/>
        </Border>
    </Grid>
</UserControl>