<UserControl x:Class="Asmroner.Wpf.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                Background="#F3F4F6"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Text="同步能力（阶段 5 增强）"/>
                <TextBlock Margin="0,8,0,0"
                           Foreground="#4B5563"
                           Text="当前批次已落地元数据同步、本地 SQLite 入库、同步下载容量控制、失败重试、状态导出与统计报表；并新增同步进度持久化、断点继续与温和停止按钮。"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,12">
            <Button x:Name="SyncMetadataButton"
                    Width="180"
                    Height="32"
                    Margin="0,0,12,8"
                    Content="开始同步元数据"
                    Click="OnSyncMetadataClicked"/>
            <Button x:Name="SyncDownloadButton"
                    Width="180"
                    Height="32"
                    Margin="0,0,12,8"
                    Content="开始同步下载"
                    Click="OnSyncDownloadClicked"/>
            <Button x:Name="RetryFailedButton"
                    Width="140"
                    Height="32"
                    Margin="0,0,12,8"
                    Content="重试失败项"
                    Click="OnRetryFailedClicked"/>
            <Button x:Name="ExportFailedButton"
                    Width="140"
                    Height="32"
                    Margin="0,0,12,8"
                    Content="导出失败记录"
                    Click="OnExportFailedClicked"/>
            <Button x:Name="ExportCompletedButton"
                    Width="140"
                    Height="32"
                    Margin="0,0,12,8"
                    Content="导出成功记录"
                    Click="OnExportCompletedClicked"/>
            <Button x:Name="RefreshStatusButton"
                    Width="120"
                    Height="32"
                    Margin="0,0,12,8"
                    Content="刷新统计"
                    Click="OnRefreshStatusClicked"/>
        </WrapPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,6">
            <TextBlock x:Name="CurrentCountTextBlock"
                       Margin="0,0,0,6"
                       FontWeight="SemiBold"
                       Text="本地元数据：0 条（字幕 0 条）"/>
            <TextBlock x:Name="DownloadCountTextBlock"
                       FontWeight="SemiBold"
                       Text="同步下载：已完成 0 项，失败 0 项，待处理 0 项，队列中 0 项，已落盘 0 B"/>
        </StackPanel>

        <Grid Grid.Row="3"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,8"
                    Padding="12"
                    Background="#F9FAFB"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="元数据统计"/>
                    <TextBlock x:Name="MetadataBreakdownTextBlock"
                               Margin="0,6,0,0"
                               Foreground="#374151"
                               Text="总量 0 条，字幕 0 条，无字幕 0 条"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0,0,8"
                    Padding="12"
                    Background="#F9FAFB"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="完成统计"/>
                    <TextBlock x:Name="CompletedBreakdownTextBlock"
                               Margin="0,6,0,0"
                               Foreground="#374151"
                               Text="已完成 0 条，字幕 0 条，无字幕 0 条，已落盘 0 B"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="12"
                    Background="#F9FAFB"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="积压统计"/>
                    <TextBlock x:Name="BacklogBreakdownTextBlock"
                               Margin="0,6,0,0"
                               Foreground="#374151"
                               Text="失败 0 条，待处理 0 条，未建同步记录 0 条"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="12"
                    Background="#F9FAFB"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="同步进度"/>
                    <TextBlock x:Name="ProgressBreakdownTextBlock"
                               Margin="0,6,0,0"
                               Foreground="#374151"
                               Text="总进度 0.00%，字幕 0.00%，无字幕 0.00%"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Margin="0,0,0,12"
                Style="{StaticResource StatusInfoPanelStyle}">
            <StackPanel>
                <TextBlock x:Name="LastSyncTextBlock"
                           Margin="0,0,0,6"
                           Style="{StaticResource StatusInfoMutedTextStyle}"
                           Text="最近更新：元数据 暂无；同步记录 暂无"/>
                <TextBlock x:Name="StatusTextBlock"
                           Style="{StaticResource StatusInfoTextStyle}"
                           Text="点击同步、重试、导出或刷新统计后，这里会显示执行状态。"/>
            </StackPanel>
        </Border>

        <TextBox x:Name="DetailsTextBox"
                 Grid.Row="5"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Text="点击同步、重试、导出或刷新统计后，这里会显示本次执行摘要。"/>
    </Grid>
</UserControl>